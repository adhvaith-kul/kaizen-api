{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kaizen-api",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-04",
  "compatibility_flags": [
    "nodejs_compat",
    "enable_nodejs_http_server_modules"
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "vars": {
    "MODE": "production"
  }
}
