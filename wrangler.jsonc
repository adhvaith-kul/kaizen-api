{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kaizen-api",
  "main": "src/worker.js",
  "compatibility_date": "2024-11-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "vars": {
    "MODE": "production"
  }
}
