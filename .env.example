# Kaizen API Environment Variables
PORT=8000
MODE=development

# Database & Supabase
DATABASE_URL="postgresql://postgres.[ref]:[pass]@[host]:6543/postgres"
SUPABASE_URL=https://[ref].supabase.co
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
SUPABASE_ANON_KEY="your-supabase-anon-key"

# Authentication JWT
JWT_SECRET="kaizen-jwt-secret-key-change-in-production"
REFRESH_SECRET="kaizen-refresh-secret-key-change-in-production"
